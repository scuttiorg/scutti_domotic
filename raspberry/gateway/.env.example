MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=gateway
MQTT_PASSWORD=changez-moi
MQTT_BASE_TOPIC=zigbee2mqtt

# https:// obligatoire
SCUTI_URL=https://scuti.example.fr
SCUTI_TOKEN=token-du-site
# Optionnel : certificat d'autorité interne (PEM) si scuti n'est pas derrière un certificat public
# SCUTI_CA=/etc/ssl/certs/mon-ca.pem

# secondes
PUSH_INTERVAL=300
PULL_INTERVAL=60
# Sans relevé capteur pendant ce délai, le radiateur est coupé (sécurité)
SENSOR_TIMEOUT=1200
