MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=gateway
MQTT_PASSWORD=changez-moi
MQTT_BASE_TOPIC=zigbee2mqtt

# https:// obligatoire
SCUTTI_URL=https://scutti.example.fr
SCUTTI_TOKEN=jeton-de-la-passerelle
# Optionnel : certificat d'autorité interne (PEM) si scutti n'est pas derrière un certificat public
# SCUTTI_CA=/etc/ssl/certs/mon-ca.pem

# secondes
PUSH_INTERVAL=300
PULL_INTERVAL=60
# Tant qu'une commande attend (appairage, renommage), on revient plus vite
PULL_INTERVAL_RAPIDE=10
# Plancher entre deux envois de la liste des appareils à Scutti
APPAREILS_INTERVAL=300
# Sans relevé capteur pendant ce délai, le radiateur est coupé (sécurité)
SENSOR_TIMEOUT=1200

# Fuseau des règles horaires (celui du bâtiment)
FUSEAU=Europe/Paris
