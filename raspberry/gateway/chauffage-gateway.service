[Unit]
Description=Passerelle chauffage (Zigbee2MQTT -> scutti)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=chauffage
Group=chauffage
WorkingDirectory=/opt/chauffage/gateway
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5

# Durcissement
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/opt/chauffage/gateway/config.cache.json
# L'état local (ce qui a été réglé sur le boîtier, avec la date de chaque
# champ) : /var/lib/chauffage, créé par systemd au nom du service. Le dossier
# du programme reste en lecture seule.
StateDirectory=chauffage
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
